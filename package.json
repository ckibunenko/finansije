{
  "name": "finansije-prodavnica",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --ip 127.0.0.1 --port 8787",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "db:local": "wrangler d1 migrations apply finansije --local",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:secrets": "node scripts/setup-secrets.mjs",
    "check:oauth": "node scripts/check-oauth.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20260907.0-alpha",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "wrangler": "^4.129.1"
  }
}
