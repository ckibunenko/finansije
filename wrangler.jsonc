{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nase-finansije",
  "account_id": "c544068a2c17462a6f8cf8aba1b74d98",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/oauth/*", "/openapi.json", "/privacy"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "finansije",
    "database_id": "6c73dfd0-29b8-4f45-86e7-ece819f78890",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["17 3 * * *"] }
}
